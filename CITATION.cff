repository-code: "https://github.com/razinkele/sfincs"
license: GPL-3.0-or-later
keywords:
  - SFINCS
  - compound flooding
  - Curonian Lagoon
  - storm surge
  - Storm Xaver
  - hydrodynamic modelling
