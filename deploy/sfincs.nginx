# SFINCS Curonian Lagoon viewer — nginx location blocks.
#
# Installed by deploy/deploy.sh into the HTTPS server block of
# /etc/nginx/sites-available/nid4ocean, before the "Database Admin Tools"
# section.  Modelled on the /telemac/ block: it is the most recent Python
# Shiny entry and carries X-Forwarded-Prefix, which the app needs to build
# correct URLs when it is mounted under a sub-path.
#
# proxy_read_timeout is 86400s to match the other model panels — figure and
# netCDF reads are slower than a typical page, and a websocket that is idle
# while a user reads a validation table must not be culled.

    # =========================================================================
    # SFINCS — Curonian Lagoon flood model viewer (Python Shiny via port 3838)
    # =========================================================================

    location /sfincs/ {
        proxy_pass http://127.0.0.1:3838/sfincs/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /sfincs;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 86400s;
        proxy_buffering off;
    }

    location = /sfincs {
        return 301 /sfincs/;
    }
